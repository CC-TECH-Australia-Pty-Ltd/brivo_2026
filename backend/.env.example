# Copy to backend/.env for local development. Never commit real credentials.
BRIVO_ENVIRONMENT=local
# API role: low privilege, cannot bypass Row-Level Security.
BRIVO_DATABASE_URL=postgresql+psycopg://brivo_app:brivo_app@localhost:5432/brivo
# Migration role: owns the four schemas. Used only by Alembic (`make migrate`).
BRIVO_MIGRATION_DATABASE_URL=postgresql+psycopg://brivo_owner:brivo_owner@localhost:5432/brivo
